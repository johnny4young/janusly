                  {
                    "id": "det-total",
                    "sourceNodeId": "calc",
                    "kind": "expression",
                    "passWhen": "context.calc.output.total == \"10\"",
                    "action": "observe",
                    "message": "total out of bounds"
                  }
                ],
                "evaluationFixtures": [
                  {
                    "id": "fx-pass",
                    "sourceNodeId": "calc",
                    "output": {
                      "total": "10"
                    },
                    "expected": "pass"
                  },
                  {
                    "id": "fx-violation",
                    "sourceNodeId": "calc",
                    "output": {
                      "total": "900"
                    },
                    "expected": "violation"
                  }
                ]
              }
            },
            "evidence": {
              "required": [
                "failure_snapshot",
                "audit_trail",
