{
  "components": {
    "schemas": {
      "V1Envelope": {
        "description": "The v1 success envelope: apiVersion + requestId (echoed as X-Request-Id) around the data payload.",
        "properties": {
          "apiVersion": {
            "const": "v1",
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "apiVersion",
          "requestId"
        ],
        "type": "object"
      },
      "V1ErrorEnvelope": {
        "description": "The v1 error envelope: a stable code, a human message, and optional params.",
        "properties": {
          "apiVersion": {
            "const": "v1",
            "type": "string"
          },
          "error": {
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "params": {
                "type": "object"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "apiVersion",
          "requestId",
          "error"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Generated from the side-effect-free route manifest in internal/contract. Every response wraps in the v1 envelope; the envelope is documented once in components and referenced everywhere.",
    "title": "Janusly Go pilot — v1 API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
