# syntax=docker/dockerfile:1
# Production images for the Janusly API and worker.
#
#   docker build -f Dockerfile.prod --target api    -t janusly-api .
#   docker build -f Dockerfile.prod --target worker -t janusly-worker .
#
# Differences from the development API image (Dockerfile.api):
#   - frozen lockfile install (reproducible; CI-equivalent)
#   - runs as a non-root user
#   - NODE_ENV=production, no watch mode
#   - the api target carries a HEALTHCHECK against GET /health
#
# The workspace is TS-first (packages ship src/*.ts; `build` is tsc --noEmit),
# so the runtime executes TypeScript via tsx — a full install is required
# (tsx is a workspace devDependency). Remember to run the two-file index
# rollout (production-rollout.sql) and `pnpm migrate` before pointing a new
# image at the database — both api and worker fail fast on unapplied
# migrations via assertMigrationsApplied().

FROM node:24-alpine AS base

WORKDIR /app

RUN corepack enable
RUN addgroup -S janusly && adduser -S janusly -G janusly \
  && chown janusly:janusly /app

# Manifests first so the install layer caches across source-only changes.
COPY --chown=janusly:janusly package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY --chown=janusly:janusly apps/api/package.json apps/api/package.json
COPY --chown=janusly:janusly apps/web/package.json apps/web/package.json
COPY --chown=janusly:janusly packages/ai/package.json packages/ai/package.json
COPY --chown=janusly:janusly packages/data/package.json packages/data/package.json
COPY --chown=janusly:janusly packages/db/package.json packages/db/package.json
COPY --chown=janusly:janusly packages/domain/package.json packages/domain/package.json
COPY --chown=janusly:janusly packages/engine/package.json packages/engine/package.json
COPY --chown=janusly:janusly packages/mcp-server/package.json packages/mcp-server/package.json
COPY --chown=janusly:janusly packages/sdk-node/package.json packages/sdk-node/package.json
COPY --chown=janusly:janusly packages/shared/package.json packages/shared/package.json
COPY --chown=janusly:janusly packages/solution-packs/package.json packages/solution-packs/package.json

USER janusly

RUN pnpm install --frozen-lockfile

COPY --chown=janusly:janusly . .

ENV NODE_ENV=production

# ── API ──────────────────────────────────────────────────────────────────────
FROM base AS api

EXPOSE 3001

# GET /health is the unauthenticated liveness probe (see docs/api.md).
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3001/health || exit 1

CMD ["pnpm", "--filter", "@janusly/api", "exec", "tsx", "src/index.ts"]

# ── Worker ───────────────────────────────────────────────────────────────────
FROM base AS worker

# No HTTP surface — BullMQ liveness is observable via queue metrics; the
# container's process liveness is the restart signal.
CMD ["pnpm", "--filter", "@janusly/engine", "exec", "tsx", "src/worker.ts"]
