{
  "name": "janusly",
  "private": true,
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "dev:doctor": "node scripts/dev-doctor.mjs",
    "stop": "docker compose stop",
    "clean": "docker compose down -v",
    "build": "pnpm -r build",
    "lint": "oxlint --max-warnings 0 && node scripts/check-i18n-casts.mjs && node scripts/check-css-classes.mjs && node scripts/check-public-repo-hygiene.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint:fix": "oxlint --fix",
    "bundle-report": "node scripts/bundle-report.mjs",
    "bundle-check": "node scripts/bundle-report.mjs --check --markdown artifacts/web-bundle-report.md --json artifacts/web-bundle-report.json",
    "contract:generate": "pnpm --filter @janusly/api contract:generate",
    "contract:check": "pnpm --filter @janusly/api contract:check",
    "test": "pnpm -r test",
    "test:browser": "pnpm --filter @janusly/web test:browser",
    "test:accessibility": "node scripts/run-e2e.mjs accessibility.spec.ts",
    "test:performance": "pnpm --filter @janusly/web build && pnpm --filter @janusly/web test:performance",
    "test:e2e": "node scripts/run-e2e.mjs",
    "migrate": "pnpm --filter @janusly/db db:migrate",
    "evals": "node scripts/run-evals.mjs",
    "evals:local": "node scripts/run-evals-local.mjs",
    "evals:baseline": "node scripts/run-evals.mjs --update-baseline",
    "evals:recovery": "pnpm --filter @janusly/api exec tsx ../../scripts/run-recovery-evals.mjs",
    "evals:recovery:baseline": "pnpm --filter @janusly/api exec tsx ../../scripts/run-recovery-evals.mjs --update-baseline",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:evals": "pnpm test:scripts && pnpm evals:recovery",
    "seed:recovery-matrix": "pnpm --filter @janusly/api exec tsx ../../scripts/seed-recovery-matrix.ts",
    "seed:demos": "pnpm --filter @janusly/api exec tsx ../../scripts/seed-demos.ts",
    "seed:full": "pnpm --filter @janusly/api exec tsx ../../scripts/seed-full.ts",
    "backfill:usage-workflowid": "pnpm --filter @janusly/api exec tsx ../../scripts/backfill-usage-workflowid.ts",
    "test:integration": "node scripts/run-integration.mjs",
    "observability:up": "docker compose -f deploy/observability/compose.local.yml up -d",
    "observability:down": "docker compose -f deploy/observability/compose.local.yml down",
    "observability:check": "node --test scripts/observability-config.test.mjs",
    "local:up": "node scripts/local-stack.mjs up",
    "local:clean-install": "node scripts/local-stack.mjs clean-install --auth",
    "local:clean-install:smoke": "node scripts/local-clean-install-smoke.mjs",
    "local:upgrade-rollback:smoke": "node scripts/local-upgrade-rollback-smoke.mjs",
    "local:down": "node scripts/local-stack.mjs down",
    "local:reset": "node scripts/local-stack.mjs reset",
    "local:restart": "node scripts/local-stack.mjs restart",
    "local:status": "node scripts/local-stack.mjs status",
    "local:db:verify": "node scripts/local-stack.mjs verify-db",
    "local:db:verify-empty": "node scripts/local-stack.mjs verify-db --auth --expect-empty",
    "local:backup": "node scripts/local-backup.mjs backup",
    "local:restore": "node scripts/local-backup.mjs restore",
    "local:logs": "node scripts/local-stack.mjs logs",
    "local:smoke": "node scripts/local-stack-smoke.mjs",
    "local:pagerduty-smoke": "node scripts/local-pagerduty-smoke.mjs",
    "local:failure-smoke": "node scripts/local-stack-smoke.mjs --failure=slack",
    "local:recovery-lab": "node scripts/recovery-lab.mjs",
    "local:recovery-lab:destroy": "node scripts/recovery-lab.mjs --destroy",
    "local:recovery-lab:ui-smoke": "node scripts/recovery-lab-ui-smoke.mjs",
    "local:semantic-outcome-ui-smoke": "node scripts/semantic-outcome-ui-smoke.mjs",
    "local:ui-smoke": "node scripts/local-stack-ui-smoke.mjs",
    "local:verify": "node scripts/local-stack-smoke.mjs --restart",
    "local:auth:up": "node scripts/local-stack.mjs up --auth",
    "local:auth:down": "node scripts/local-stack.mjs down --auth",
    "local:auth:reset": "node scripts/local-stack.mjs reset --auth",
    "local:auth:restart": "node scripts/local-stack.mjs restart --auth",
    "local:auth:status": "node scripts/local-stack.mjs status --auth",
    "local:auth:ui-smoke": "node scripts/local-identity-ui-smoke.mjs"
  },
  "devDependencies": {
    "oxc-parser": "^0.140.0",
    "oxlint": "^1.74.0",
    "supabase": "2.109.1"
  }
}
