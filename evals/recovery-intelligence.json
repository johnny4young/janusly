    {
      "id": "apply-retry-only-repair",
      "kind": "repair",
      "capability": "repair_application",
      "input": {
        "original": {
          "dslVersion": "1.0",
          "id": "payment-retry",
          "nodes": [
            {
              "id": "charge",
              "type": "http",
              "config": {
                "url": "https://payments.example/charge",
                "method": "POST",
                "retry": {
                  "maxAttempts": 1
                }
              }
            }
          ],
          "edges": []
        },
        "failingNodeId": "charge",
        "operation": {
          "type": "config_patch",
          "patch": {
            "retry": {
              "maxAttempts": 3
            }
          }
        }
      },
      "expect": {
        "repairClass": "retry",
        "validWorkflow": true,
        "safety": {
          "writeSide": true,
          "approvalRequired": true,
          "approvalPresent": false
        }
      }
    },
