        "baseline": {
          "dslVersion": "1.0",
          "id": "qualification",
          "nodes": [
            {
              "id": "outcome",
              "type": "noop",
              "config": {}
            }
          ],
          "edges": [],
          "recovery": {
            "contract": {
              "version": "2",
              "failure": {
                "technical": {
                  "terminalNodeFailure": true,
                  "stalledNode": true
                },
                "semantic": {
                  "mode": "deterministic",
                  "detectors": [
                    {
                      "id": "approved-outcome",
                      "sourceNodeId": "outcome",
                      "kind": "expression",
                      "passWhen": "context.outcome.output.approved === true",
                      "action": "quarantine",
                      "message": "The outcome must be approved"
                    }
