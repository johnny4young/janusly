# syntax=docker/dockerfile:1

FROM node:24-alpine AS build

WORKDIR /app

RUN corepack enable

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY packages/ai/package.json packages/ai/package.json
COPY packages/data/package.json packages/data/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/domain/package.json packages/domain/package.json
COPY packages/engine/package.json packages/engine/package.json
COPY packages/mcp-server/package.json packages/mcp-server/package.json
COPY packages/sdk-node/package.json packages/sdk-node/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/solution-packs/package.json packages/solution-packs/package.json

RUN pnpm install --frozen-lockfile

COPY . .

ARG VITE_API_URL=http://localhost:3001
ARG VITE_SUPABASE_URL=
ARG VITE_SUPABASE_ANON_KEY=
ARG JANUSLY_BUILD_ID=local-docker
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV JANUSLY_BUILD_ID=$JANUSLY_BUILD_ID

RUN pnpm --filter @janusly/web build

FROM node:24-alpine AS runtime

WORKDIR /app

COPY --from=build --chown=node:node /app/apps/web/dist ./dist
COPY --chown=node:node deploy/local/serve-web.mjs ./serve-web.mjs

USER node

ENV NODE_ENV=production
ENV PORT=3000
ENV STATIC_ROOT=/app/dist

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/ >/dev/null || exit 1

CMD ["node", "serve-web.mjs"]
