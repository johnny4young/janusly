FROM node:24-alpine

WORKDIR /app

RUN corepack enable

COPY package.json pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
# apps/web depends on the @janusly/shared workspace package, so its manifests
# must be present for pnpm to resolve the `workspace:*` link at install time.
COPY packages ./packages

RUN pnpm install

COPY . .

RUN pnpm --filter @janusly/web build

# Static file server, installed globally through pnpm so the image stays
# package-manager-consistent (no npm in a pnpm repo). pnpm places global
# binaries under PNPM_HOME, which must be on PATH for `serve` to resolve.
ENV PNPM_HOME="/usr/local/share/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN pnpm add -g serve

EXPOSE 3000

CMD ["serve", "-s", "apps/web/dist", "-l", "3000"]
