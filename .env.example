# Janusly process configuration. Copy to .env for local overrides; never commit
# credentials. React uses same-origin API requests and has no API URL setting.

# Core runtime
JANUSLY_DATABASE_URL=postgres://janusly:janusly-local@127.0.0.1:5432/janusly?sslmode=disable
JANUSLY_ENV=development
JANUSLY_PORT=3001
JANUSLY_INTERNAL_HOST=127.0.0.1
JANUSLY_INTERNAL_PORT=9464
JANUSLY_WORKER_CONCURRENCY=8
JANUSLY_API_POOL_SIZE=10
JANUSLY_WORKER_POOL_SIZE=0
JANUSLY_POLL_MS=250
JANUSLY_HTTP_TIMEOUT_MS=30000
JANUSLY_FEEDBACK_MEMORY_WORKERS=4
JANUSLY_FEEDBACK_MEMORY_QUEUE_CAPACITY=256
JANUSLY_FEEDBACK_MEMORY_TIMEOUT_MS=15000

# Production security (required where noted)
# JANUSLY_RESUME_TOKEN_SECRET=replace-with-a-long-random-secret
# JANUSLY_CREDENTIAL_MASTER_KEY=base64-or-64-hex-encoded-32-byte-key
# JANUSLY_CREDENTIAL_MASTER_KEY_FILE=/run/secrets/janusly-credential-key
ALLOW_DEV_AUTH_HEADERS=false
ALLOW_PRIVATE_HTTP_TARGETS=false

# Supabase authentication (optional external integration)
# SUPABASE_URL=https://example.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# VITE_SUPABASE_URL=https://example.supabase.co
# VITE_SUPABASE_ANON_KEY=

# WorkOS enterprise identity (optional external integration)
# WORKOS_CLIENT_ID=
# WORKOS_API_KEY=
# WORKOS_WEBHOOK_SECRET=
# JANUSLY_SSO_CALLBACK_URL=https://janusly.example.com/auth/sso/callback
# JANUSLY_WEB_BASE_URL=https://janusly.example.com
# Local Supabase only; production HTTPS providers are already covered by CSP.
# JANUSLY_BROWSER_CONNECT_ORIGINS=http://127.0.0.1:7431

# AI completion (optional; deterministic fallback remains available)
JANUSLY_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# JANUSLY_LLM_MAX_OUTPUT_UNITS=4096
# JANUSLY_AI_GENERATION_MODE=free_json
# JANUSLY_AI_GENERATION_CANDIDATES=1

# Memory and embeddings (optional)
JANUSLY_MEMORY_ENABLED=false
JANUSLY_EMBEDDING_PROVIDER=ollama
JANUSLY_EMBEDDING_MODEL=bge-m3
OLLAMA_BASE_URL=http://127.0.0.1:11434
# JANUSLY_OLLAMA_TIMEOUT_MS=30000

# Outbound HTTP safety
# JANUSLY_HTTP_MAX_RESPONSE_BYTES=1000000
# JANUSLY_HTTP_MAX_REDIRECTS=5
# JANUSLY_HTTP_STREAM_PREVIEW_BYTES=65536

# Shareable links and MCP write consent (optional)
# JANUSLY_PUBLIC_APP_URL=https://janusly.example.com
# JANUSLY_MCP_WRITES_ENABLED=false
# Read-only default: workflows.read,runs.read,dlq.read,recovery.read
# JANUSLY_MCP_PERMISSIONS=workflows.read,runs.read,dlq.read,recovery.read
# JANUSLY_MCP_CLIENT_WRITES_ENABLED=false

# Object store and mail integrations (optional)
# JANUSLY_OBJECT_STORE_PROVIDER=noop
# JANUSLY_OBJECT_STORE_BUCKET=
# JANUSLY_OBJECT_STORE_REGION=us-east-1
# JANUSLY_OBJECT_STORE_ENDPOINT=
# JANUSLY_MAILER_PROVIDER=noop
# JANUSLY_MAILER_FROM=onboarding@example.com
# RESEND_API_KEY=
# SENDGRID_API_KEY=

# Observability
# OTEL_EXPORTER=none
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# OTEL_SERVICE_INSTANCE_ID=

# Frontend build-time integration values. There is deliberately no API URL.
# VITE_DOCS_URL=https://docs.example.com
