# Root env defaults. `packages/db/src/env.ts` loads this file first, then
# `.env` overrides it. Keep real secrets in `.env` or a vault, not here.
# Safe tenant-level runtime overrides are cataloged in the `org_configs`
# table and managed through `GET/POST /org/config`; env values remain the
# process defaults.

# ----- Core services -----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/workflow
REDIS_URL=redis://localhost:6379

# ----- API -----
PORT=3001
API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
API_MAX_JSON_BODY_BYTES=1048576
# API_SERVICE_TOKEN=
# JANUSLY_REQUIRE_SAVED_WORKFLOW=false
# JANUSLY_PRODUCTION_MODE=false
# JANUSLY_REQUIRE_EVAL_COVERAGE=false
# JANUSLY_STREAM_MAX_SUBSCRIPTIONS=50
# JANUSLY_PUBLIC_APP_URL=http://localhost:5173

# ----- Worker / engine -----
WORKER_CONCURRENCY=10
JANUSLY_MAX_SUBWORKFLOW_DEPTH=5
# HMAC key for signed human_form resume tokens and Janusly SSO state/session
# tokens. Required in production; dev can rely on the local fallback.
# JANUSLY_RESUME_TOKEN_SECRET=

# ----- Recovery containment (both default ON; set to false to disable) -----
# Transient-error fast path: retry a rate limit / dropped connection / gateway
# timeout on a bounded per-class ladder instead of dead-lettering it. Write-side
# errors never tier — a possibly-committed effect stays an operator decision.
# JANUSLY_TRANSIENT_TIER_ENABLED=false
# Circuit breaker: pause a workflow after N consecutive failed ORDINARY runs
# (default 5; per-workflow + per-org overrides win). Resuming is manual —
# `POST /workflows/:id/resume` — because nothing can know the fault is fixed.
# JANUSLY_CIRCUIT_BREAKER_ENABLED=false

# ----- Outbound HTTP safety -----
ALLOW_PRIVATE_HTTP_TARGETS=false
JANUSLY_HTTP_TIMEOUT_MS=30000
JANUSLY_HTTP_MAX_RESPONSE_BYTES=1000000
JANUSLY_HTTP_MAX_REDIRECTS=5
# Preview bytes persisted for streaming HTTP bodies (`bodyMode: "stream"`).
# JANUSLY_HTTP_STREAM_PREVIEW_BYTES=65536

# ----- Janusly AI (optional, Anthropic-supported MVP) -----
# Get your key at https://console.anthropic.com/settings/keys and add credit
# at https://console.anthropic.com/settings/billing. Without a selected
# provider key, AI endpoints fall back to deterministic logic and `agent`
# nodes use the rules planner. With it, Janusly acts as a real AI operator.
# JANUSLY_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OPENAI_TIMEOUT_MS=30000
# OPENAI_MAX_RETRIES=2
# AI_PROMPT_MAX_CHARS=4000
# AI_RATE_LIMIT_PER_MIN=30
# Workflow generation mechanism for /ai/generate-workflow (env fallback for
# the org_configs.ai.generationMode key). free_json (default) parses the
# model's JSON text server-side — better reliability/quality/cost and
# provider-agnostic; constrained uses the legacy provider structured-output.
# JANUSLY_AI_GENERATION_MODE=free_json
# Best-of-N: candidates sampled per free_json generation, best kept by a
# deterministic readiness score (no LLM judge). 1 = single-shot (default);
# 2-5 trade a few cheap calls for lower variance. Ignored in constrained mode.
# JANUSLY_AI_GENERATION_CANDIDATES=1

# ----- LLM provider selection -----
# When unset, the provider defaults to `anthropic` — the supported posture
# for production AI surfaces. Setting it explicitly is still recommended so
# the deployment documents its intent. Don't point a tenant at another
# provider unless product explicitly re-opens it with a verification plan.
# Currently registered providers: `openai`, `anthropic`. Adding a new
# provider is a four-field entry in `packages/ai/src/llm-client.ts`.
# OPENAI_API_KEY=sk-xxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o-mini
#
# Per-call overrides (in workflow node `config.model` or API request body):
#   "claude-haiku-4-5-20251001" — bare model id, uses configured provider
#   "anthropic/claude-haiku-4-5-20251001" — `provider/model` spec, overrides for that one call

# ----- LLM cost overrides -----
# Per-model price overrides (USD per 1M tokens; "<input>,<output>"). The
# chokepoint multiplies these against the AI SDK's reported usage to fill
# `usage_events.metadata.costUsd`. Built-in defaults live in
# `packages/ai/src/pricing.ts`. Unknown models record `costUsd: null` —
# set the env override when prices shift.
# The key suffix is the model id uppercased with non-alphanumerics collapsed
# to "_" (e.g. claude-haiku-4-5-20251001 -> CLAUDE_HAIKU_4_5_20251001). A
# per-call model override needs its own matching key.
# JANUSLY_LLM_PRICE_GPT_4O_MINI=0.15,0.60
# JANUSLY_LLM_PRICE_CLAUDE_HAIKU_4_5_20251001=1.00,5.00

# ----- Runtime memory / embeddings (optional) -----
# Persistent memory is off unless BOTH flags are set: this process flag and the
# tenant flag `org_configs.memory.enabled=true`. Then opt in at least one kind
# through `memory.allowedKinds` via POST /org/config.
# JANUSLY_MEMORY_ENABLED=false
# JANUSLY_EMBEDDING_PROVIDER=ollama
# JANUSLY_EMBEDDING_MODEL=bge-m3
# Host-side `pnpm dev` processes reach the Compose Ollama service through the
# published localhost port. Containerized API/worker deployments can use
# http://ollama:11434 instead.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# JANUSLY_OLLAMA_TIMEOUT_MS=30000
# JANUSLY_MEMORY_RETENTION_CRON=0 3 * * *
# JANUSLY_MEMORY_PURGE_DELAY_MS=604800000

# ----- Supabase auth (optional) -----
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# ALLOW_DEV_AUTH_HEADERS=false

# ----- Web -----
VITE_API_URL=http://localhost:3001
# Optional HTTPS documentation destination. When absent or invalid, the web
# app hides Docs actions instead of presenting dead controls.
# VITE_DOCS_URL=https://docs.example.com

# ----- MCP server -----
# Used when running `pnpm --filter @janusly/mcp-server start`.
JANUSLY_API_URL=http://127.0.0.1:3001
JANUSLY_API_ORG_ID=default
JANUSLY_API_USER_ID=mcp-user
# JANUSLY_API_SERVICE_TOKEN=
# Opt-in to MCP write tools (currently `workflows.save`). Default off — set
# this in both API and MCP-server processes. When unset or non-"true", MCP write
# tools stay absent from the advertised catalog and/or the API returns a clear
# `mcp_process_disabled` error. The API ALSO requires per-tenant opt-in via
# `org_configs.mcp.writeConsent = true`; both gates must pass for any MCP write.
# JANUSLY_MCP_WRITES_ENABLED=false

# ----- MCP client (`mcp_tool` workflow node) -----
# Stdio transports fail closed unless at least one allowlist is set here or in
# org_configs.mcp.clientCommandAllowlist.
# JANUSLY_MCP_ALLOWED_COMMANDS=node,npx,uvx
# External MCP write tools require BOTH this process flag and
# org_configs.mcp.clientWriteConsent=true.
# JANUSLY_MCP_CLIENT_WRITES_ENABLED=false
# JANUSLY_MCP_CLIENT_RATE_LIMIT_PER_MIN=60
# JANUSLY_MCP_STDIO_MAX_LIFETIME_MS=600000
# JANUSLY_MCP_STDIO_MAX_STDERR_BYTES=65536
# JANUSLY_MCP_STDIO_MAX_VM_KB=524288
# JANUSLY_MCP_SANDBOX_ENFORCE_LINUX=

# ----- Integration tools -----
# Per-org rate-limit overrides. Defaults are 60/60/120 per minute respectively.
# JANUSLY_SLACK_RATE_LIMIT_PER_MIN=60
# JANUSLY_GITHUB_RATE_LIMIT_PER_MIN=60
# JANUSLY_WEBHOOK_RATE_LIMIT_PER_MIN=120
# JANUSLY_PDF_RATE_LIMIT_PER_MIN=30

# ----- Email delivery -----
# `email.send` defaults to noop until a provider and provider key are present.
# Tenant org_config overrides can set email.provider/email.from/email.rateLimitPerMin.
# JANUSLY_MAILER_PROVIDER=noop
# JANUSLY_MAILER_FROM=onboarding@resend.dev
# JANUSLY_EMAIL_RATE_LIMIT_PER_MIN=100
# RESEND_API_KEY=
# SENDGRID_API_KEY=
#
# Example credential env vars referenced by `credentials.secret_ref` rows.
# Operators insert one credentials row per integration with kind in
# (`slack_webhook` | `github_token` | `webhook_secret`) and `secret_ref` set
# to the env-var name. The workflow JSON refers to the credential by name
# only — never the credential URL / API token / signing secret itself.
# SLACK_INCIDENTS_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/abc
# GITHUB_BOT_TOKEN=ghp_yourPersonalAccessToken
# WEBHOOK_SIGNING_SECRET=replace-with-32-char-random-string

# ----- PDF object store -----
# `pdf.generate` defaults to noop until an object store is configured. Use
# `local` for dev smoke tests, or `s3` for AWS S3 / MinIO / Cloudflare R2 /
# Backblaze-compatible storage. Bucket credentials come from the AWS SDK env
# chain (for example AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY).
# JANUSLY_OBJECT_STORE_PROVIDER=noop
# JANUSLY_OBJECT_STORE_LOCAL_DIR=/tmp/janusly-pdfs
# JANUSLY_OBJECT_STORE_BUCKET=
# JANUSLY_OBJECT_STORE_REGION=us-east-1
# JANUSLY_OBJECT_STORE_ENDPOINT=
# JANUSLY_OBJECT_STORE_PUBLIC_BASE_URL=
# JANUSLY_OBJECT_STORE_PRESIGNED_TTL_SEC=3600

# ----- System schedulers / retention -----
# Invalid cron values warn and fall back to the defaults below.
# JANUSLY_RETENTION_CRON=0 5 * * *
# JANUSLY_RETENTION_RUN_EVENTS_DAYS=90
# JANUSLY_RETENTION_AUDIT_LOGS_DAYS=365
# JANUSLY_RETENTION_USAGE_EVENTS_DAYS=90
# JANUSLY_RETENTION_RECOVERY_FEEDBACK_DAYS=180
# JANUSLY_RETENTION_MEMORY_ENTRIES_DAYS=90
# JANUSLY_AUDIT_LOGS_RETENTION_CRON=0 2 * * *
# JANUSLY_AUDIT_LOGS_RETENTION_DAYS=730
# JANUSLY_SCIM_EVENTS_RETENTION_CRON=0 4 * * *
# JANUSLY_SCIM_EVENTS_RETENTION_DAYS=90
# JANUSLY_UPSTREAM_HEALTH_CRON=* * * * *
# Stalled-node reaper — fails production-run nodes left `running` past the
# threshold (the signature of a worker that crashed mid-node) into the DLQ so
# the run reaches a terminal state instead of being stuck forever. Threshold is
# minutes, clamped to [15, 1440]; keep it well above your longest legitimate
# single-node execution.
# JANUSLY_STALLED_NODE_REAPER_CRON=*/5 * * * *
# JANUSLY_STALLED_NODE_THRESHOLD_MINUTES=60

# ----- Auto-healing / alerts -----
# JANUSLY_AUTO_HEALING_ENABLED=false
# JANUSLY_AUTO_HEALING_AUTO_APPLY=false
# JANUSLY_AUTO_HEALING_SCAN_CRON=0 */6 * * *
# JANUSLY_AUTO_HEALING_WATCH_CRON=* * * * *
# JANUSLY_ALERTS_ENABLED=false
# JANUSLY_ALERTS_SCAN_CRON=*/2 * * * *

# ----- Observability (optional) -----
# OTEL_METRICS_PORT is PER-PROCESS (api defaults to 9464, worker to 9465).
# Never set it globally here: dotenvx injects this file into BOTH processes,
# so a shared value makes the worker collide with the api's Prometheus bind
# and die silently under tsx watch (runs stay queued forever).
# OTEL_METRICS_PORT=9464
# OTEL_SERVICE_INSTANCE_ID=
# OTEL_EXPORTER=jaeger
# OTEL_EXPORTER_JAEGER_ENDPOINT=http://localhost:14268/api/traces

# ----- Local test/eval helpers -----
JANUSLY_EVALS_API_URL=http://127.0.0.1:3001
PLAYWRIGHT_BASE_URL=http://127.0.0.1:5173
# PLAYWRIGHT_SKIP_WEB_SERVER=1

# ----- WorkOS enterprise SSO (optional) -----
# Sign up at workos.com → create a project → copy these from
# Dashboard → Configuration → API Keys.
# WORKOS_CLIENT_ID=client_…
# WORKOS_API_KEY=sk_test_…  (or sk_live_… in production; never logged)
# Callback URL MUST be registered in WorkOS Dashboard → Redirects
# (byte-for-byte; WorkOS rejects mismatches).
# JANUSLY_SSO_CALLBACK_URL=http://localhost:3001/auth/sso/callback
# Web base URL the callback redirects back to with the session token
# in the URL fragment.
# JANUSLY_WEB_BASE_URL=http://localhost:5173
# Set to 'true' to bypass enforced-SSO orgs during local development.
# Defaults false — the gate fires outside production too, so a
# staging-on-prod misconfig fails closed instead of silently bypassing.
# ALLOW_DEV_SSO_BYPASS=
# SSO session and state tokens both reuse JANUSLY_RESUME_TOKEN_SECRET
# (with a purpose discriminator). Production MUST set this dedicated
# secret; dev falls back to a local default.

# ----- WorkOS SCIM directory sync (optional) -----
# Shared HMAC secret WorkOS uses to sign Directory Sync webhooks. Copy
# from Dashboard → Configuration → Webhooks. Empty/unset rejects every
# inbound webhook (fails closed). The /webhooks/workos/directory route
# verifies `WorkOS-Signature: t=<unix-milliseconds>,v1=<hex>` against the raw body
# with HMAC-SHA256, ±5 minute timestamp tolerance.
# WORKOS_WEBHOOK_SECRET=
