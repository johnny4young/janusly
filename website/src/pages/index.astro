---
import Base from '~/layouts/Base.astro';
import Hero from '~/components/Hero.astro';
import TrustStrip from '~/components/TrustStrip.astro';
import WhyCards from '~/components/WhyCards.astro';
import ProductTour from '~/components/ProductTour.astro';
import PricingTeaser from '~/components/PricingTeaser.astro';
import Faq from '~/components/Faq.astro';
import FinalCTA from '~/components/FinalCTA.astro';

const locale = 'en';
---

<Base locale={locale}>
  <Hero locale={locale} />
  <TrustStrip locale={locale} />
  <WhyCards locale={locale} />
  <ProductTour locale={locale} />
  <PricingTeaser locale={locale} />
  <Faq locale={locale} />
  <FinalCTA locale={locale} />
</Base>
