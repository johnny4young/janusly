---
import '~/styles/tokens.css';
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { SITE } from '~/lib/site';
import { alternateLinks, canonicalUrl, getLocaleMeta, type Locale, t } from '~/lib/i18n';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { locale, title, description, noindex = false } = Astro.props;
const copy = t(locale);
const localeMeta = getLocaleMeta(locale);
const pageTitle = title ?? copy.meta.title;
const pageDescription = description ?? copy.meta.description;
const canonicalHref = canonicalUrl(locale, Astro.url.pathname);
const alternates = alternateLinks(Astro.url.pathname);
const ogImage = new URL('/og-default.svg', SITE.url).toString();
const cfAnalytics = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN as string | undefined;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE.name,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Linux, macOS, Docker',
  url: SITE.url,
  description: pageDescription,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', description: 'Self-hosted' },
};
---

<!doctype html>
<html lang={localeMeta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalHref} />
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={localeMeta.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#245bff" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
  </head>
  <body>
    <Header locale={locale} currentPath={Astro.url.pathname} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    {cfAnalytics && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${cfAnalytics}"}`} />
    )}
  </body>
</html>
