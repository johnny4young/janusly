---
import { Icon } from 'astro-icon/components';
import { type Locale, t } from '~/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const items = [
  { icon: 'lucide:box', label: copy.trust.binary },
  { icon: 'lucide:database', label: copy.trust.postgres },
  { icon: 'lucide:share-2', label: copy.trust.mcp },
  { icon: 'lucide:activity', label: copy.trust.otel },
  { icon: 'lucide:shield-check', label: copy.trust.selfHosted },
];
---

<section class="trust" aria-label="Platform facts">
  <ul class="container trust-list">
    {
      items.map((item) => (
        <li>
          <Icon name={item.icon} class="trust-icon" />
          <span>{item.label}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .trust {
    padding: 2rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .trust-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .trust-list li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink-soft);
  }
  .trust-icon {
    width: 20px;
    height: 20px;
    color: var(--color-primary);
  }
</style>
