---
import { Icon } from 'astro-icon/components';
import { type Locale, t } from '~/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const c = copy.compare;
type Cell = 'yes' | 'no' | string;
const rows: Array<{ label: string; janusly: Cell; ipaas: Cell; lowcode: Cell; engine: Cell }> = [
  { label: c.rows.selfHosted.label, janusly: 'yes', ipaas: 'no', lowcode: 'yes', engine: c.rows.selfHosted.engine },
  { label: c.rows.recovery.label, janusly: 'yes', ipaas: c.rows.recovery.ipaas, lowcode: c.rows.recovery.lowcode, engine: c.rows.recovery.engine },
  { label: c.rows.operator.label, janusly: 'yes', ipaas: c.rows.operator.ipaas, lowcode: c.rows.operator.lowcode, engine: 'no' },
  { label: c.rows.mcp.label, janusly: 'yes', ipaas: c.rows.mcp.ipaas, lowcode: c.rows.mcp.lowcode, engine: 'no' },
  { label: c.rows.budgets.label, janusly: 'yes', ipaas: c.rows.budgets.ipaas, lowcode: c.rows.budgets.lowcode, engine: c.rows.budgets.engine },
];
---

<section id="compare" class="section">
  <div class="container compare">
    <div class="section-head">
      <span class="kicker">{c.kicker}</span>
      <h2 class="h2">{c.title}</h2>
      <p class="lede">{c.lede}</p>
    </div>
    <div class="card table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col" class="cap">{c.capability}</th>
            <th scope="col" class="us">{c.columns.janusly}</th>
            <th scope="col">{c.columns.ipaas}</th>
            <th scope="col">{c.columns.lowcode}</th>
            <th scope="col">{c.columns.engine}</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                {[row.janusly, row.ipaas, row.lowcode, row.engine].map((cell) =>
                  cell === 'yes' ? (
                    <td><Icon name="lucide:check" class="mark yes" aria-label={c.yes} /></td>
                  ) : cell === 'no' ? (
                    <td><Icon name="lucide:x" class="mark no" aria-label={c.no} /></td>
                  ) : (
                    <td><span class="partial">{cell}</span></td>
                  ),
                )}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="compare-note">{c.note}</p>
  </div>
</section>

<style>
  .compare {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .table-wrap {
    overflow-x: auto;
  }
  table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
  }
  thead th {
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  thead th.cap {
    width: 34%;
  }
  thead th.us {
    color: var(--color-primary);
  }
  tbody th,
  tbody td {
    padding: 1rem;
    border-bottom: 1px solid #eef2f7;
    text-align: left;
    vertical-align: middle;
    font-size: var(--text-body);
  }
  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }
  tbody th {
    font-weight: 600;
  }
  .mark {
    width: 20px;
    height: 20px;
  }
  .mark.yes {
    color: var(--color-success);
  }
  .mark.no {
    color: var(--color-border-strong);
  }
  .partial {
    font-size: var(--text-small);
    color: var(--color-muted);
  }
  .compare-note {
    font-size: var(--text-small);
    color: var(--color-muted);
  }
</style>
