---
import { type Locale, t } from '~/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const p = copy.product;
---

<section id="product" class="section tour">
  <div class="container tour-inner">
    <div class="tour-head">
      <div class="section-head">
        <span class="kicker kicker-night">{p.kicker}</span>
        <h2 class="h2 h2-night">{p.title}</h2>
        <p class="lede lede-night">{p.lede}</p>
      </div>
      <div class="tour-tabs" aria-hidden="true">
        <span class="tab is-active">{p.tabs.recovery}</span>
        <span class="tab">{p.tabs.studio}</span>
        <span class="tab">{p.tabs.operations}</span>
      </div>
    </div>

    <div class="tour-grid">
      <article class="panel">
        <header class="panel-head">
          <span class="panel-kicker">{p.cluster.kicker}</span>
          <span class="mono accent">{p.cluster.count}</span>
        </header>
        <h3>{p.cluster.title}</h3>
        <dl class="facts">
          <div><dt>{p.cluster.cause}</dt><dd class="mono">{p.cluster.causeValue}</dd></div>
          <div><dt>{p.cluster.firstSeen}</dt><dd class="mono">08:58</dd></div>
          <div><dt>{p.cluster.blast}</dt><dd class="mono">{p.cluster.blastValue}</dd></div>
        </dl>
        <div class="panel-actions">
          <span class="chip chip-primary">{p.cluster.replay}</span>
          <span class="chip">{p.cluster.open}</span>
        </div>
      </article>

      <article class="panel">
        <header class="panel-head">
          <span class="panel-kicker">{p.healing.kicker}</span>
          <span class="validated"><span class="dot"></span>{p.healing.validated}</span>
        </header>
        <h3>{p.healing.title}</h3>
        <p class="panel-body">{p.healing.body}</p>
        <pre class="diff"><span class="del">- retries: 0</span>
<span class="add">+ retries: 3, backoff: exponential</span></pre>
        <div class="panel-actions">
          <span class="chip chip-primary">{p.healing.approve}</span>
          <span class="chip">{p.healing.reject}</span>
        </div>
      </article>

      <article class="panel">
        <header class="panel-head">
          <span class="panel-kicker">{p.operations.kicker}</span>
          <span class="mono muted">{p.operations.window}</span>
        </header>
        <div class="stats">
          <div><span class="stat-label">{p.operations.queueLag}</span><span class="mono stat-value">48 ms</span></div>
          <div><span class="stat-label">{p.operations.recovered}</span><span class="mono stat-value ok">97.8%</span></div>
          <div><span class="stat-label">{p.operations.spend}</span><span class="mono stat-value">$12.40</span></div>
          <div><span class="stat-label">{p.operations.budgetLeft}</span><span class="mono stat-value">$37.60</span></div>
        </div>
        <p class="panel-note">{p.operations.note}</p>
      </article>
    </div>
    <p class="sample-note">{p.sampleNote}</p>
  </div>
</section>

<style>
  .tour {
    background: var(--color-night);
    color: #ffffff;
  }
  .tour-inner {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .tour-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }
  .kicker-night {
    color: #67e8f9;
  }
  .h2-night {
    color: #ffffff;
  }
  .lede-night {
    color: var(--color-night-text);
  }
  .tour-tabs {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .tab {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-md);
    padding: 0 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-night-border);
    color: var(--color-night-text);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .tab.is-active {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: #ffffff;
    font-weight: 700;
  }
  .tour-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .panel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--color-night-elevated);
    border: 1px solid var(--color-night-border);
  }
  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .panel-kicker {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-night-muted);
  }
  .accent {
    font-size: var(--text-xs);
    color: #67e8f9;
  }
  .muted {
    font-size: var(--text-xs);
    color: var(--color-night-muted);
  }
  .panel h3 {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .facts {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
  }
  .facts > div {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--color-night-text);
  }
  .facts dd {
    margin: 0;
    color: #ffffff;
  }
  .panel-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 0.875rem;
    border-radius: var(--radius-sm);
    border: 1px solid #475569;
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-night-text);
  }
  .chip-primary {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: #ffffff;
    font-weight: 700;
  }
  .validated {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-xs);
    font-weight: 700;
    color: #34d399;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: #34d399;
  }
  .panel-body {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-night-text);
  }
  .diff {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 0;
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    background: var(--color-night);
    font-size: var(--text-xs);
    white-space: pre-wrap;
  }
  .del {
    color: var(--color-night-muted);
  }
  .add {
    color: #67e8f9;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .stats > div {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.875rem;
    border-radius: var(--radius-sm);
    background: var(--color-night);
  }
  .stat-label {
    font-size: var(--text-xs);
    color: var(--color-night-muted);
  }
  .stat-value {
    font-size: 1.25rem;
    font-weight: 600;
  }
  .stat-value.ok {
    color: #34d399;
  }
  .panel-note {
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--color-night-muted);
  }
  .sample-note {
    font-size: var(--text-small);
    color: var(--color-muted);
  }
  @media (max-width: 1000px) {
    .tour-head {
      flex-direction: column;
      align-items: flex-start;
    }
    .tour-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
