---
import { type Locale, t } from '~/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const p = copy.product;
const screens = [
  { key: 'recovery', src: '/screens/recovery-center.jpg', ...p.screens.recovery },
  { key: 'studio', src: '/screens/ai-studio.jpg', ...p.screens.studio },
  { key: 'home', src: '/screens/home.jpg', ...p.screens.home },
];
---

<section id="product" class="section tour">
  <div class="container tour-inner">
    <div class="section-head">
      <span class="kicker kicker-night">{p.kicker}</span>
      <h2 class="h2 h2-night">{p.title}</h2>
      <p class="lede lede-night">{p.lede}</p>
    </div>

    <div class="screens">
      {
        screens.map((screen, index) => (
          <figure class:list={['screen', index === 0 && 'is-lead']}>
            <div class="screen-frame">
              <img src={screen.src} alt={screen.alt} width="1440" height="900" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
            </div>
            <figcaption>
              <span class="screen-title">{screen.title}</span>
              <span class="screen-caption">{screen.caption}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tour {
    background: var(--color-night);
    color: #ffffff;
  }
  .tour-inner {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .kicker-night {
    color: #67e8f9;
  }
  .h2-night {
    color: #ffffff;
  }
  .lede-night {
    color: var(--color-night-text);
  }
  .screens {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .screen {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    margin: 0;
  }
  .screen.is-lead {
    grid-column: 1 / -1;
  }
  .screen-frame {
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-night-border);
    background: var(--color-night-elevated);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.35);
  }
  .screen-frame img {
    width: 100%;
    height: auto;
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .screen-title {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .screen-caption {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-night-text);
  }
  @media (max-width: 900px) {
    .screens {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
