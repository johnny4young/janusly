---
import { SITE } from '~/lib/site';
import { type Locale, t } from '~/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
---

<section id="pricing" class="section access">
  <div class="container section-head">
    <span class="kicker">{copy.pricing.kicker}</span>
    <h2 class="h2">{copy.pricing.title}</h2>
    <p>{copy.pricing.body}</p>
    <a href={SITE.contactUrl} class="btn btn-primary" rel="external noopener">{copy.pricing.cta}</a>
  </div>
</section>

<style>
  .access {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
</style>
