---
import { Icon } from 'astro-icon/components';
import { type Locale, t } from '~/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
---

<section class="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="pill">
        <Icon name="lucide:check" class="pill-icon" />
        {copy.hero.pill}
      </span>
      <h1>{copy.hero.title}</h1>
      <p class="lede">{copy.hero.lede}</p>
      <div class="hero-actions">
        <a href="#access" class="btn btn-primary">{copy.common.requestAccess}</a>
        <a href="#product" class="btn">{copy.common.seeRecoveryCenter}</a>
      </div>
      <p class="hero-note">{copy.hero.note}</p>
    </div>
    <figure class="hero-visual">
      <div class="card frame">
        <div class="frame-bar">
          <span></span><span></span><span></span>
          <span class="mono frame-url">/#/runs/dlq</span>
        </div>
        <div class="frame-shot">
          <img src="/screens/recovery-queue.jpg" alt={copy.hero.screenshotAlt} width="790" height="880" loading="eager" fetchpriority="high" />
        </div>
      </div>
      <figcaption>{copy.hero.caption}</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(2.5rem, 6vw, 5.5rem) 0 clamp(2rem, 5vw, 4.5rem);
    background: linear-gradient(180deg, #ffffff 0%, var(--color-bg) 100%);
  }
  .hero-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 50% at 78% 30%, rgba(6, 182, 212, 0.12) 0%, rgba(6, 182, 212, 0) 70%),
      radial-gradient(50% 45% at 20% 20%, rgba(36, 91, 255, 0.1) 0%, rgba(36, 91, 255, 0) 70%);
    pointer-events: none;
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4rem;
    align-items: center;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    align-self: flex-start;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-ink-soft);
  }
  .pill-icon {
    width: 16px;
    height: 16px;
    color: var(--color-success);
  }
  h1 {
    font-size: var(--text-display);
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
    font-weight: 800;
  }
  .hero-copy .lede {
    max-width: 36rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .hero-note {
    font-size: var(--text-small);
    color: var(--color-muted);
  }
  .hero-visual {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
  }
  .frame {
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }
  .frame-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 40px;
    padding: 0 0.875rem;
    border-bottom: 1px solid var(--color-border);
  }
  .frame-bar > span:not(.frame-url) {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-pill);
    background: var(--color-border);
  }
  .frame-url {
    margin-left: 0.75rem;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  .frame-shot {
    height: clamp(260px, 30vw, 420px);
    overflow: hidden;
  }
  .frame-shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  figcaption {
    text-align: center;
    font-size: var(--text-small);
    color: var(--color-muted);
  }
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
    .hero-actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
