FROM node:24-alpine

WORKDIR /app

RUN mkdir -p /data && chown -R node:node /data /app

COPY --chown=node:node deploy/local/provider-simulator.mjs ./provider-simulator.mjs

USER node

ENV PORT=4010
ENV SIMULATOR_DATA_DIR=/data

VOLUME ["/data"]
EXPOSE 4010

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=6 \
  CMD wget -qO- http://127.0.0.1:4010/health || exit 1

CMD ["node", "provider-simulator.mjs"]
