# Host-side ports. All published services bind to loopback only.
JANUSLY_LOCAL_WEB_PORT=7310
JANUSLY_LOCAL_API_PORT=7311
JANUSLY_LOCAL_SIMULATOR_PORT=4010
JANUSLY_LOCAL_POSTGRES_PORT=5432
JANUSLY_LOCAL_REDIS_PORT=6379
JANUSLY_LOCAL_API_METRICS_PORT=9464
JANUSLY_LOCAL_WORKER_METRICS_PORT=9465
JANUSLY_LOCAL_OLLAMA_PORT=11434

# Persistent local database identity. This is for the isolated local stack,
# not a public deployment secret.
JANUSLY_LOCAL_POSTGRES_PASSWORD=janusly-local
JANUSLY_LOCAL_RESUME_TOKEN_SECRET=local-resume-token-secret-change-before-sharing
JANUSLY_LOCAL_ORG_ID=default
JANUSLY_LOCAL_MAILER_FROM=janusly@example.test

# Provider posture. The simulator is the safe default. To exercise real
# providers, set this to false and fill only the secrets you intend to use.
JANUSLY_LOCAL_INTEGRATION_SIMULATOR=true
GITHUB_TOKEN=
SLACK_WEBHOOK_URL=
WEBHOOK_SIGNING_SECRET=
JANUSLY_MAILER_PROVIDER=simulator
RESEND_API_KEY=
SENDGRID_API_KEY=

# Browser-visible URLs compiled into the static web image and allowed by CORS.
JANUSLY_LOCAL_API_URL=http://localhost:7311
JANUSLY_LOCAL_WEB_URL=http://localhost:7310
JANUSLY_LOCAL_WEB_ORIGINS=http://localhost:7310,http://127.0.0.1:7310
JANUSLY_BUILD_ID=local-docker
JANUSLY_SESSION_COOKIE_SECURE=false
JANUSLY_IDENTITY_RETENTION_CRON=0 3 * * *
JANUSLY_IDENTITY_SESSION_RETENTION_DAYS=7

# Optional real Anthropic completions. Leave blank to exercise Janusly's
# deterministic AI fallback and side-effect validity gates at zero cost.
ANTHROPIC_API_KEY=

# Optional persistent memory. Starting the Ollama profile is not sufficient:
# tenant memory.enabled and memory.allowedKinds must also be configured.
JANUSLY_MEMORY_ENABLED=false
JANUSLY_EMBEDDING_PROVIDER=ollama
JANUSLY_EMBEDDING_MODEL=bge-m3

# Optional overrides.
JANUSLY_WORKER_CONCURRENCY=2
JANUSLY_POSTGRES_IMAGE=pgvector/pgvector:pg18
OTEL_EXPORTER=console
