# Copy to cloud.env and fill values from the Grafana Cloud "Send data" page.
# The token needs metrics:write and traces:write scopes. Never commit cloud.env.
GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus.example.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USERNAME=123456
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-example.grafana.net/otlp
GRAFANA_CLOUD_INSTANCE_ID=123456
GRAFANA_CLOUD_API_TOKEN=replace-with-a-cloud-access-policy-token
JANUSLY_ENVIRONMENT=production
JANUSLY_METRICS_ADDRESS=host.docker.internal:9464
