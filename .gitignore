# Dev-harness state (generated credential master key, local scratch).
.dev/

# `go build ./cmd/<name>` drops the executable in the repository root.
# The documented helper commands (seed, admin, loadgen, mcp, contract,
# artifact) would otherwise show up as untracked litter after every build.
/admin
/api
/artifact
/contract
/loadgen
/mcp
/seed
