{
  "name": "@janusly/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "contract:generate": "tsx src/openapi-cli.ts --write",
    "contract:check": "tsx src/openapi-cli.ts --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run --config vite.integration.config.ts"
  },
  "dependencies": {
    "@janusly/ai": "workspace:*",
    "@janusly/data": "workspace:*",
    "@janusly/db": "workspace:*",
    "@janusly/domain": "workspace:*",
    "@janusly/engine": "workspace:*",
    "@janusly/shared": "workspace:*",
    "@janusly/solution-packs": "workspace:*",
    "@supabase/supabase-js": "^2.110.2",
    "bullmq": "^5.80.2",
    "drizzle-orm": "1.0.0-rc.4-5d5b77c",
    "ioredis": "^5.11.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "fast-check": "^4.9.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
