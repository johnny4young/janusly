{
  "id": "support-escalation",
  "name": "Support escalation",
  "description": "When a support ticket comes in, summarize it with AI, let a human agent review and edit the reply, escalate to the support channel, and email the customer back.",
  "category": "support_escalation",
  "version": "1.2.0",
  "requiredCredentials": [
    {
      "name": "support_slack",
      "kind": "slack_webhook",
      "purpose": "Escalates the ticket to your support channel"
    }
  ],
  "requiredOrgConfigs": [
    {
      "key": "email.from",
      "purpose": "Sender address used to reply to the customer"
    }
  ],
  "workflowJson": {
    "dslVersion": "1.0",
    "templatePolicy": "strict",
    "id": "support-escalation",
    "name": "Support escalation",
    "inputs": {
      "type": "object",
      "required": [
        "event"
      ],
      "properties": {
        "event": {
          "type": "object",
          "required": [
            "eventId",
            "payload"
          ],
          "properties": {
            "eventId": {
              "type": "string",
              "description": "Stable delivery id from the support system"
            },
            "payload": {
              "type": "object",
              "required": [
                "customer",
                "subject",
                "message"
              ],
              "properties": {
                "customer": {
                  "type": "string",
                  "description": "Customer email"
                },
                "subject": {
                  "type": "string",
                  "description": "Ticket subject line"
                },
                "message": {
                  "type": "string",
                  "description": "The customer's full message"
                }
              }
            }
          }
        }
      }
    },
    "nodes": [
      {
        "id": "trigger",
        "type": "webhook_received",
        "config": {
          "endpointKey": "support-escalation"
        }
      },
      {
        "id": "summarize",
        "type": "ai",
        "config": {
          "prompt": "Summarize this support ticket in at most two sentences and draft a polite reply under 150 words without inventing product features. Return JSON with exactly two string fields named summary and draftReply. Subject: {{context.trigger.output.event.payload.subject}}\n\nMessage: {{context.trigger.output.event.payload.message}}",
          "outputSchema": {
            "type": "object",
            "required": [
              "summary",
              "draftReply"
            ],
            "properties": {
              "summary": {
                "type": "string"
              },
              "draftReply": {
                "type": "string"
              }
            }
          }
        }
      },
      {
        "id": "review",
        "type": "human_form",
        "config": {
          "title": "Review the support reply before it goes out",
          "description": "Edit the drafted reply if needed and approve to send it to the customer.",
          "schema": {
            "type": "object",
            "required": [
              "finalReply"
            ],
            "properties": {
              "finalReply": {
                "type": "string",
                "description": "Final reply body. Pre-filled from the AI draft; edit as needed."
              },
              "priority": {
                "type": "string",
                "description": "Optional priority tag",
                "enum": [
                  "low",
                  "high"
                ]
              }
            }
          },
          "initialValues": {
            "finalReply": "{{context.summarize.output.data.draftReply}}",
            "priority": "high"
          }
        }
      },
      {
        "id": "escalate",
        "type": "tool",
        "config": {
          "tool": "slack.post",
          "resultPolicy": "require_ok",
          "input": {
            "credential": "support_slack",
            "text": ":ticket: Support ticket from {{context.trigger.output.event.payload.customer}} — {{context.trigger.output.event.payload.subject}} (priority {{context.review.output.priority}})"
          }
        }
      },
      {
        "id": "reply",
        "type": "tool",
        "config": {
          "tool": "email.send",
          "resultPolicy": "require_ok",
          "input": {
            "to": "{{context.trigger.output.event.payload.customer}}",
            "subject": "Re: {{context.trigger.output.event.payload.subject}}",
            "text": "{{context.review.output.finalReply}}"
          }
        }
      }
    ],
    "edges": [
      {
        "from": "trigger",
        "to": "summarize"
      },
      {
        "from": "summarize",
        "to": "review"
      },
      {
        "from": "review",
        "to": "escalate"
      },
      {
        "from": "escalate",
        "to": "reply"
      }
    ],
    "outputs": {
      "customer": "{{context.trigger.output.event.payload.customer}}",
      "summary": "{{context.summarize.output.data.summary}}",
      "finalReply": "{{context.review.output.finalReply}}",
      "escalated": "{{context.escalate.output.result.ok}}",
      "replied": "{{context.reply.output.result.ok}}"
    }
  },
  "samplePayloads": [
    {
      "id": "default",
      "label": "Customer can't log in",
      "input": {
        "event": {
          "endpointKey": "support-escalation",
          "eventId": "sample-ticket-login-lockout",
          "eventType": "support.ticket_created",
          "payload": {
            "customer": "dana@customer.test",
            "subject": "Locked out after password reset",
            "message": "I reset my password an hour ago and now the app says my account doesn't exist. Please help — I have a deadline today."
          }
        }
      }
    }
  ],
  "failureFixtures": [
    {
      "id": "support_secret_unbound",
      "label": "Support channel credential unavailable",
      "description": "The escalation node crosses the real worker and terminal-failure boundary. The retry policy classifies a controlled missing-secret probe as non-retryable before any Slack request can start.",
      "failureMode": "credential_unavailable",
      "recoveryPath": "runtime_failure",
      "failedNodeId": "escalate"
    }
  ]
}
